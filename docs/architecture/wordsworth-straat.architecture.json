  "cards": [
    {
      "dot": "cyan",
      "title": "Pijplijn (in-process, hervatbaar)",
      "items": [
        "profile → (OCR nld) → extract (pypdf, tekst alleen in geheugen) → de-identify → embed → index",
        "Append-only audittabel is de state machine; retries 3× met backoff, run hervatbaar",
        "Idempotent: content-addressed sha256, al geïndexeerd = skipped"
      ]
    },
    {
      "dot": "emerald",
      "title": "Zeef als library (geen service)",
      "items": [
        "cosine-eindranker over de RRF-recallset (hybrid)",
        "tokenizer in de embedder",
        "key-lifecycle audit als append-only JSONL"
      ]
    },
    {
      "dot": "violet",
      "title": "Batch-intake",
      "items": [
        "wordsworth-ingest Job leest PVC /corpus en draait dezelfde pipeline",
        "corpus-loader is een tijdelijke pod (RWO), daarna weg",
        "Nextcloud-connector bewust extern proces, koppelt via POST /ingest"
      ]
    },
    {
      "dot": "amber",
      "title": "Fase B — default UIT",
      "items": [
        "HMAC-tokens [TYPE:hash8], mappings AES-256-GCM in Postgres",
        "Envelope-encryptie: datakey per (PII-type, versie), gewrapt door OpenBao Transit; KEK verlaat OpenBao nooit",
        "Reveal = grant-scope én key-beschikbaarheid; sealed OpenBao ⇒ fail-closed, nooit klare PII naar de index"
      ]
    },
    {
      "dot": "rose",
      "title": "Hardening",
      "items": [
        "Pods non-root, read-only rootfs, caps dropped, seccomp",
        "Rate limits op /search /hybrid /ask; optionele X-API-Key",
        "Bekende zwakke hop: klare PII over in-cluster http naar OpenAnonymiser (mTLS open punt)"
      ]
    }
  ]
}